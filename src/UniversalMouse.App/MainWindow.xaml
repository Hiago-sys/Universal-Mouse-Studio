<Window x:Class="UniversalMouse.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UniversalMouse.App" Title="Universal Mouse Studio 0.1.2" Width="1180" Height="820" MinWidth="900" MinHeight="650">
<DockPanel>
 <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="22,16"><Grid><StackPanel><TextBlock Text="◈   UNIVERSAL MOUSE STUDIO" FontWeight="Bold" FontSize="18"/><TextBlock Text="Controle consciente. Movimento preciso." Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="{Binding HookStatus}" MaxWidth="250" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Content="Minimizar" Click="OnMinimize"/><Button Content="PARAR · Ctrl+Alt+F11" Command="{Binding StopCommand}" Background="#8D3544" Foreground="White"/></StackPanel></Grid></Border>
 <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Padding="18,10"><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"/></Border>
 <TabControl TabStripPlacement="Left" SelectedIndex="{Binding PageIndex}">
  <TabItem Header="01   Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Style="{StaticResource Heading}" Text="Seu mouse, com mais possibilidades."/><TextBlock Style="{StaticResource Note}" Text="Configurações do Windows e processamento local, com capacidades físicas sempre identificadas separadamente."/>
   <Border Background="{DynamicResource CardBrush}" Padding="22" CornerRadius="10" Margin="0,14"><StackPanel><TextBlock Text="DISPOSITIVO SELECIONADO" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding DeviceName}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceSummary}"/><TextBlock Text="{Binding SystemSummary}"/><TextBlock Text="{Binding ActiveProfileSummary}"/></StackPanel></Border>
   <TextBlock Style="{StaticResource Subheading}" Text="Estado real"/><TextBlock Text="{Binding HookStatus}"/><TextBlock Text="{Binding CursorSummary}"/><TextBlock Text="DPI físico: não informado pelo dispositivo. Velocidade do ponteiro não altera o DPI do sensor."/><TextBlock Text="{Binding PollingSummary}"/><TextBlock Text="Iluminação: nenhum adaptador de protocolo específico instalado."/>
   <WrapPanel><Button Content="Atualizar dispositivos" Command="{Binding RefreshCommand}"/><Button Content="Ler configurações atuais" Command="{Binding ReadSettingsCommand}"/><Button Content="Exportar relatório técnico" Command="{Binding ReportCommand}"/></WrapPanel>
   <TextBlock Style="{StaticResource Note}" Text="Versão 0.1 • Integrações Windows implementadas e compiladas; validação em hardware pendente. Nenhum driver é instalado. Correção desativada ao iniciar."/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="02   Dispositivos"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Style="{StaticResource Heading}" Text="Dispositivos conectados"/><TextBlock Style="{StaticResource Note}" Text="Enumeração pelo Windows, metadados HID quando acessíveis. Conexão e desconexão atualizam a lista. A seleção filtra o laboratório; ajustes do Windows e o hook são globais."/>
   <Button Content="Atualizar" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
   <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" MinHeight="100" MaxHeight="210"/>
   <TextBlock Style="{StaticResource Subheading}" Text="Ficha técnica"/><TextBlock Text="{Binding DeviceDetails}"/>
   <TextBlock Style="{StaticResource Subheading}" Text="Compatibilidade"/>
   <ItemsControl ItemsSource="{Binding CapabilityLines}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBrush}" CornerRadius="5" Padding="12" Margin="0,3"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="03   Sensibilidade e DPI"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Style="{StaticResource Heading}" Text="Sensibilidade e DPI"/><TextBlock Style="{StaticResource Note}" Text="Os controles abaixo alteram configurações globais do Windows. Não modificam DPI físico nem entradas Raw Input recebidas por jogos."/>
   <TextBlock Text="{Binding PointerSpeed,StringFormat=Velocidade do ponteiro: {0} / 20}"/><Slider Minimum="1" Maximum="20" Value="{Binding PointerSpeed}"/>
   <CheckBox Content="Aprimorar precisão do ponteiro (aceleração do Windows)" IsChecked="{Binding EnhancePointerPrecision}"/>
   <WrapPanel><Button Content="Aplicar ajustes ao Windows" Command="{Binding ApplySettingsCommand}"/><Button Content="Reler valores reais" Command="{Binding ReadSettingsCommand}"/><Button Content="Restaurar valores da abertura" Command="{Binding RestoreCommand}"/></WrapPanel>
   <TextBlock Style="{StaticResource Subheading}" Text="Calibração por distância"/><TextBlock Style="{StaticResource Note}" Text="Inicie a captura, mova o mouse sobre uma régua e informe a distância física. O resultado estima contagens/polegada pelos eventos relativos; não lê nem configura o sensor. Mova apenas o mouse selecionado."/>
   <TextBlock Text="Distância percorrida (cm)"/><TextBox Text="{Binding CalibrationCentimeters,UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
   <WrapPanel><Button Content="Iniciar medição" Command="{Binding StartCalibrationCommand}"/><Button Content="Concluir medição" Command="{Binding FinishCalibrationCommand}"/></WrapPanel><TextBlock Text="{Binding CalibrationResult}"/>
   <TextBlock Style="{StaticResource Subheading}" Text="DPI do hardware"/><TextBlock Text="Compatibilidade desconhecida. Nenhum protocolo de sensor identificado. DPI por eixo, perfis físicos e botão DPI não são configuráveis nesta versão."/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="04   Angle Snapping"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Style="{StaticResource Heading}" Text="Angle Snapping"/><TextBlock Style="{StaticResource Note}" Text="Correção angular por software • O laboratório processa deltas Raw Input. O modo cursor processa coordenadas já transformadas pelo Windows e exige ativação explícita. Não há substituição universal de Raw Input."/>
   <WrapPanel><Button Content="Ativar correção do cursor" Command="{Binding StartCommand}" Background="#226556" Foreground="White"/><Button Content="Desativar imediatamente" Command="{Binding StopCommand}"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/></WrapPanel><TextBlock Text="{Binding HookStatus}"/><TextBlock Text="{Binding CursorSummary}"/>
   <UniformGrid Columns="2"><StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Strength,StringFormat=Intensidade: {0:F0}%}"/><Slider Minimum="0" Maximum="100" Value="{Binding Strength}"/><TextBlock Text="{Binding Tolerance,StringFormat=Tolerância angular: {0:F0}°}"/><Slider Minimum="0" Maximum="30" Value="{Binding Tolerance}"/><CheckBox Content="Correção horizontal" IsChecked="{Binding Horizontal}"/><Slider Minimum="0" Maximum="100" Value="{Binding HorizontalStrength}" ToolTip="Intensidade horizontal (%)"/><CheckBox Content="Correção vertical" IsChecked="{Binding Vertical}"/><Slider Minimum="0" Maximum="100" Value="{Binding VerticalStrength}" ToolTip="Intensidade vertical (%)"/></StackPanel><StackPanel><CheckBox Content="Correção diagonal (opcional)" IsChecked="{Binding Diagonal}"/><TextBlock Text="Ângulo diagonal / complementar (graus)"/><Slider Minimum="1" Maximum="89" Value="{Binding DiagonalDegrees}"/><TextBlock Text="{Binding Smoothing,StringFormat=Suavização independente: {0:F0}%}"/><Slider Minimum="0" Maximum="90" Value="{Binding Smoothing}"/><TextBlock Text="{Binding DetectionDistance,StringFormat=Distância de detecção: {0:F0} contagens/pixels}"/><Slider Minimum="0" Maximum="100" Value="{Binding DetectionDistance}"/><TextBlock Text="{Binding Hysteresis,StringFormat=Histerese: {0:F0}°}"/><Slider Minimum="0" Maximum="10" Value="{Binding Hysteresis}"/><CheckBox Content="Aplicar algoritmo no laboratório" IsChecked="{Binding LabCorrection}"/></StackPanel></UniformGrid>
   <TextBlock Style="{StaticResource Subheading}" Text="Laboratório de movimento"/><TextBlock Style="{StaticResource Note}" Text="Verde: trajetória corrigida. Cinza: deslocamento bruto. Captura somente durante o teste e na memória. O botão Repetir reproduz as amostras retidas com os ajustes atuais; não move o cursor."/>
   <WrapPanel><Button Content="{Binding LabCaptureButtonText}" Command="{Binding ToggleLabCommand}"/><Button Content="Escolher mouse pelo movimento" Command="{Binding UseMovingMouseCommand}"/><Button Content="Limpar" Command="{Binding ClearLabCommand}"/><Button Content="Repetir teste" Command="{Binding ReplayLabCommand}"/></WrapPanel>
   <TextBlock Text="{Binding LabInputSummary}" Foreground="{DynamicResource AccentBrush}"/>
   <local:MotionLab x:Name="Lab" Height="245" Focusable="True" AutomationProperties.Name="Comparação de trajetórias de movimento"/><TextBlock Text="{Binding LabSummary}"/>
   <TextBlock Style="{StaticResource Note}" Text="Ctrl+Alt+F11 interrompe todo o hook. Cliques e rolagem passam normalmente, salvo remapeamentos laterais ativados. Programas elevados, desktop seguro e jogos com entrada direta exigem validação separada. Não há suporte a anticheat."/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="05   Iluminação"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Iluminação"/><TextBlock Text="Integração específica necessária" FontSize="20" Foreground="{DynamicResource AccentBrush}"/><TextBlock Style="{StaticResource Note}" Text="Não existe um comando HID universal de RGB. Nenhum protocolo documentado de um mouse foi fornecido; esta versão não envia relatórios de iluminação. LED fixo ou RGB autônomo pode não aceitar controle externo."/><TextBlock Text="A arquitetura contém interfaces de adaptadores de iluminação e sensor para expansão. Cor, brilho, efeitos, sincronização e restauração física permanecem indisponíveis até haver um adaptador compatível validado."/><Button Content="Controle RGB indisponível" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="06   Botões"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Botões"/><TextBlock Style="{StaticResource Note}" Text="A inversão principal usa o Windows. O remapeamento opcional intercepta apenas X1/X2 expostos como botões laterais padrão; afeta todos os mouses e não identifica a origem física."/>
   <CheckBox Content="Inverter botões principais" IsChecked="{Binding SwapButtons}"/><Button Content="Aplicar ao Windows" Command="{Binding ApplySettingsCommand}" HorizontalAlignment="Left"/>
   <TextBlock Style="{StaticResource Subheading}" Text="Remapeamento lateral por software"/><TextBlock Text="Botão X1"/><ComboBox ItemsSource="{Binding ButtonActions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding X1Action}"/><TextBlock Text="Botão X2"/><ComboBox ItemsSource="{Binding ButtonActions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding X2Action}"/>
   <WrapPanel><Button Content="Ativar remapeamento lateral" Command="{Binding StartButtonsCommand}"/><Button Content="Parar hook" Command="{Binding StopCommand}"/></WrapPanel><TextBlock Style="{StaticResource Note}" Text="Ativação explícita. Padrão: função original. Não há remapeamento de clique principal nem captura de teclas. Botões proprietários não expostos como X1/X2 não são suportados. Ações de iniciar aplicativos e alternar perfil por botão ainda não implementadas."/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="07   Scroll e cliques"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Scroll e cliques"/><TextBlock Text="{Binding DoubleClickMilliseconds,StringFormat=Intervalo do clique duplo: {0} ms}"/><Slider Minimum="200" Maximum="900" TickFrequency="10" Value="{Binding DoubleClickMilliseconds}"/><TextBlock Text="{Binding WheelLines,StringFormat=Linhas por rolagem: {0}}"/><Slider Minimum="0" Maximum="100" Value="{Binding WheelLines}"/><CheckBox Content="Rolar uma página por vez" IsChecked="{Binding PageScroll}"/><CheckBox Content="Rolar janelas inativas sob o ponteiro" IsChecked="{Binding InactiveScroll}"/><CheckBox Content="ClickLock do Windows" IsChecked="{Binding ClickLock}"/><WrapPanel><Button Content="Aplicar ao Windows" Command="{Binding ApplySettingsCommand}"/><Button Content="Restaurar valores da abertura" Command="{Binding RestoreCommand}"/></WrapPanel>
   <TextBlock Style="{StaticResource Subheading}" Text="Teste de botões e scroll"/><TextBlock Style="{StaticResource Note}" Text="Clique ou role na área abaixo. Contagens ficam apenas na sessão. Intervalos muito curtos são candidatos a duplicação, não um diagnóstico físico nem ajuste de debounce."/>
   <Border x:Name="ClickArea" Background="{DynamicResource CardBrush}" Height="150" CornerRadius="10" MouseDown="OnTestMouseDown" MouseWheel="OnTestWheel" Focusable="True"><TextBlock Text="ÁREA DE TESTE\nEsquerdo · direito · central · laterais · scroll" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding ClickSummary}"/><Button Content="Zerar testes" Command="{Binding ResetDiagnosticsCommand}" HorizontalAlignment="Left"/>
   <TextBlock Style="{StaticResource Note}" Text="Debounce físico e inversão de scroll não implementados. Rolagem horizontal só é contabilizada quando o dispositivo fornece eventos."/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="08   Performance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Performance"/><TextBlock Style="{StaticResource Note}" Text="Frequência estimada de eventos Raw Input durante movimento contínuo. Não mede precisamente a frequência do barramento USB nem altera polling rate físico. Pausas e agrupamento de eventos afetam o resultado."/><WrapPanel><Button Content="Iniciar teste de 10 s" Command="{Binding StartPollingCommand}"/><Button Content="Interromper teste" Command="{Binding StopPollingCommand}"/></WrapPanel><TextBlock Text="{Binding PollingSummary}" FontSize="20"/><TextBlock Text="{Binding PollingHistory}" FontFamily="Consolas"/><TextBlock Style="{StaticResource Subheading}" Text="Medições honestas"/><TextBlock Text="O teste usa relógio monotônico e janela limitada. Frequência máxima de eventos não equivale à especificação do mouse. Motion Sync, lift-off distance e polling físico dependem de protocolo específico e não estão disponíveis."/><TextBlock Text="O benchmark reproduzível do motor acompanha o código-fonte. Resultados medidos no ambiente de build estão em docs/BUILD_RESULTS.md."/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="09   Perfis"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Perfis locais"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/><TextBlock Text="Nome"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Executável associado (ex.: notepad.exe; sem caminho)"/><TextBox Text="{Binding ProfileExecutable,UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="Salvar / renomear" Command="{Binding SaveProfileCommand}"/><Button Content="Criar" Command="{Binding NewProfileCommand}"/><Button Content="Duplicar" Command="{Binding DuplicateProfileCommand}"/><Button Content="Excluir" Command="{Binding DeleteProfileCommand}"/></WrapPanel><WrapPanel><Button Content="Aplicar perfil" Command="{Binding ApplyProfileCommand}"/><Button Content="Importar JSON" Command="{Binding ImportProfileCommand}"/><Button Content="Exportar JSON" Command="{Binding ExportProfileCommand}"/><Button Content="Restaurar perfis iniciais" Command="{Binding ResetProfilesCommand}"/></WrapPanel><CheckBox Content="Trocar e aplicar perfil ao ativar aplicativo associado" IsChecked="{Binding AutoProfiles}"/><TextBlock Style="{StaticResource Note}" Text="A seleção carrega os controles; Aplicar perfil altera ajustes globais. A troca automática também altera o Windows globalmente e mantém o último perfil ao sair do aplicativo associado. Nunca ativa o hook por conta própria. Alterações do perfil são salvas localmente após uma pausa; a opção de automação não é persistida."/><TextBlock Text="{Binding PersistenceSummary}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="10   Diagnóstico"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Mouse Diagnostics"/><TextBlock Text="{Binding DiagnosticsSummary}"/><TextBlock Text="{Binding ClickSummary}"/><TextBlock Text="{Binding PollingSummary}"/><TextBlock Style="{StaticResource Note}" Text="Amarelo / inconclusivo: dados insuficientes ou candidatos a irregularidade. Nenhuma conclusão sobre defeito físico é produzida automaticamente. Conexão é observada pelo Windows; não há teste elétrico."/><WrapPanel><Button Content="Atualizar informações" Command="{Binding RefreshCommand}"/><Button Content="Exportar relatório JSON" Command="{Binding ReportCommand}"/><Button Content="Zerar testes" Command="{Binding ResetDiagnosticsCommand}"/></WrapPanel><TextBlock Text="O relatório contém contagens e ajustes; não inclui trajetórias, nome do computador ou caminhos pessoais dos dispositivos."/><TextBlock Style="{StaticResource Subheading}" Text="Validação pendente"/><TextBlock Text="Execução em Windows 10/11, hot-plug, monitores com DPI misto, suspensão/retomada, UIPI, Raw Input e recuperação após falha precisam dos testes manuais descritos em docs/TESTING.md."/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="11   Configurações"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Configurações"/><CheckBox Content="Tema claro" IsChecked="{Binding LightTheme}"/><TextBlock Style="{StaticResource Subheading}" Text="Privacidade e recuperação"/><TextBlock Text="Sem telemetria, sem captura de teclas digitadas, sem gravação persistente de trajetórias. Dados locais em %LOCALAPPDATA%\UniversalMouseStudio. Nenhuma permissão administrativa ou serviço permanente é necessário."/><Button Content="Restaurar ajustes do Windows da abertura" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/><TextBlock Style="{StaticResource Note}" Text="Ao fechar, o hook é removido e o cursor volta ao fluxo normal. Ajustes aplicados por APIs do Windows persistem, como no Painel de Controle. Para desfazê-los, use Restaurar antes de fechar. Um encerramento forçado não deve impedir o uso do mouse; essa condição requer validação no Windows."/><TextBlock Style="{StaticResource Subheading}" Text="Versão e suporte"/><TextBlock Text="Universal Mouse Studio 0.1.2 · .NET 10 · WPF · Windows x64. Executável não assinado. Sem atualizador automático, sem drivers e sem adaptadores RGB instalados."/></StackPanel></ScrollViewer></TabItem>
 </TabControl>
</DockPanel></Window>
